heals:AvocadoCheeseChilliToastRecipe a heals:Recipe ;
    rdfs:label "Avocado Cheese Chilli Toast Recipe" ;
    fkg:hasCourse "Breakfast",
        "Snack" ;
    fkg:hasCuisine fkg:Continental ;
    fkg:hasDietType fkg:Vegetarian ;
