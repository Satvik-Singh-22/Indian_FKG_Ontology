heals:MullangiMorPachadiRecipeRadishInSpicyTemperedYogurtGravyRecipe a heals:Recipe ;
    rdfs:label "Mullangi Mor Pachadi Recipe (Radish in spicy tempered Yogurt Gravy Recipe)" ;
    fkg:hasCourse "Condiment",
        "Side Dish" ;
    fkg:hasCuisine fkg:TamilNadu ;
    fkg:hasDietType fkg:Vegetarian ;
    fkg:hasImageURL "https://www.archanaskitchen.com/images/archanaskitchen/1-Author/sibyl_sunitha/Mullangi_Mor_Pachadi_Recipe_Radish_in_spicy_tempered_Curd_Gravy_Recipe.jpg"^^xsd:anyURI ;
    fkg:hasIngredient heals-ing:Asafoetida,
        heals-ing:CurryLeaves,
