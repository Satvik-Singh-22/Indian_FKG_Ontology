heals:SurtiObbattuRecipeFruitNutPoorisInSaffronMilk a heals:Recipe ;
    rdfs:label "Surti Obbattu Recipe - Fruit & Nut Pooris In Saffron Milk" ;
    fkg:hasCourse "Dessert" ;
    fkg:hasCuisine fkg:Karnataka ;
    fkg:hasDietType fkg:Vegetarian ;
    fkg:hasImageURL "https://www.archanaskitchen.com/images/archanaskitchen/1-Author/Gauravi_Vinay/Surti_Obattu.jpg"^^xsd:anyURI ;
    fkg:hasIngredient heals-ing:AllPurposeFlour,
