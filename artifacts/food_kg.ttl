    fkg:hasImageURL "https://www.archanaskitchen.com/images/archanaskitchen/1-Author/gauravi/Sagu_Masala_Dosa_1600.jpg"^^xsd:anyURI ;
    fkg:hasIngredient heals-ing:ArharDal,
