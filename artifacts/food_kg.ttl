    fkg:hasImageURL "https://www.archanaskitchen.com/images/archanaskitchen/0-Archanas-Kitchen-Recipes/2019/High_Protein_Soya_Idli_Dosa_Batter_Recipe_Video_6_1600.jpg"^^xsd:anyURI ;
