heals:WatermelonMargaritaGranitaRecipe a heals:Recipe ;
    rdfs:label "Watermelon Margarita Granita Recipe" ;
    fkg:hasCourse "Dessert" ;
    fkg:hasCuisine fkg:Continental ;
    fkg:hasDietType fkg:Vegetarian ;
    fkg:hasImageURL "https://www.archanaskitchen.com/images/archanaskitchen/1-Author/Swayampurna_Mishra/watermelon_margarita_granita.jpg"^^xsd:anyURI ;
    fkg:hasIngredient heals-ing:Lemon,
