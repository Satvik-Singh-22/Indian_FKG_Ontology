heals:HimachalPahariStyleTeliahMahRecipeBrownHorseGramCurry a heals:Recipe ;
    rdfs:label "Himachal Pahari Style Teliah Mah Recipe (Brown Horse Gram Curry)" ;
    fkg:hasCourse "Main Course" ;
