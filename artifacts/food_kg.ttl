heals:SenaiPachadiRecipeElephantOrRaita a heals:Recipe ;
    rdfs:label "Senai Pachadi Recipe (Elephant or Raita)" ;
    fkg:hasCourse "Condiment",
        "Salad" ;
    fkg:hasCuisine fkg:Indian ;
    fkg:hasDietType fkg:Vegetarian ;
    fkg:hasImageURL "https://www.archanaskitchen.com/images/archanaskitchen/1-Author/Neeru_Srikanth/Senai_Pachadi.jpg"^^xsd:anyURI ;
    fkg:hasIngredient heals-ing:Asafoetida,
        heals-ing:BlackUradDal,
        heals-ing:CorianderLeaves,
        heals-ing:Curd,
        heals-ing:ElephantYam,
        heals-ing:Ginger,
        heals-ing:GreenChilli,
        heals-ing:MustardSeeds,
        heals-ing:Salt,
        heals-ing:SunflowerOil ;
    fkg:hasInstruction """To begin making the Senai Pachadi recipe, peel the skin of yam and chop them into squares.Add water to cover the yam and steam them in pressure cooker till the cooker releases 3 whistles.Add coriander leaves, chilli, ginger and yam into a mixer.Strain the water before adding yam but do not throw the water.
Grind the mix.Heat oil in a tadka pan and add the items given in ‘For Tempering’ in the order given.Mix the ground mixture, yogurt and remaining water and give it a stir.Once it is done, mix everything with the raita, pour the tempering and serve.Serve Senai Pachadi along with Mixed Vegetable Sambar, Cauliflower Thoran and Hot Steamed Rice."""^^xsd:string ;
    fkg:hasURL "https://www.archanaskitchen.com/senai-pachadi-recipe-elephant-yam-raita"^^xsd:anyURI ;
    fkg:preparationTime 40 .

heals:SenaiPotatoCurryRecipeSpicyChettinadStyleYumStirPre a heals:Recipe ;
    rdfs:label "Senai Potato Curry Recipe - Spicy Chettinad Style Yum Stir Pre" ;
    fkg:hasCourse "Main Course" ;
    fkg:hasCuisine fkg:SouthIndian ;
    fkg:hasDietType fkg:Vegetarian ;
