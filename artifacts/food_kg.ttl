    fkg:hasImageURL "https://www.archanaskitchen.com/images/archanaskitchen/1-Author/sibyl_sunitha/Malabar_Style_Dates_Coriander_Chutney_Recipe_.jpg"^^xsd:anyURI ;
    fkg:hasIngredient heals-ing:CorianderLeaves,
