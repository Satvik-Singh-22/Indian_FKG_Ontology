        heals-ing:RadishGreens,
        heals-ing:Salt,
        heals-ing:TurmericPowder ;
    fkg:hasInstruction """To begin making the Mooli Bhurji Recipe, wash radish and the leaves.
Scrap and finely chop the radish.
Chop fresh leaves too.Heat oil in a wok, add mustard seeds and when it splutters add carom seeds, asafoetida, turmeric powder and green chillies.Next add the chopped radish and the green leaves.
Add some salt and saute.
Continue cooking on medium flame stirring in between.After some time you will observe that the veggies have started leaving water.
Continue stirring the vegetables till they are cooked and water has evaporated .Finally, add amchur powder, mix and switch off the stove.Serve Mooli Bhurji along with Panchmel Dal and Phulkas for a weekday meal with your family."""^^xsd:string ;
    fkg:hasURL "https://www.archanaskitchen.com/mooli-bhurji-recipe"^^xsd:anyURI ;
    fkg:preparationTime 35 .

heals:MooliRaitaRecipeRadishRaitaRecipe a heals:Recipe ;
    rdfs:label "Mooli Raita Recipe - Radish Raita Recipe" ;
    fkg:hasCourse "Condiment",
        "Salad" ;
    fkg:hasCuisine fkg:Indian ;
    fkg:hasDietType fkg:Vegetarian ;
    fkg:hasImageURL "https://www.archanaskitchen.com/images/archanaskitchen/Indian_Raitas/Mooli_Raita_Recipe_Spiced_Yogurt_Salad_with_Radish-1-2.jpg"^^xsd:anyURI ;
    fkg:hasIngredient heals-ing:CuminPowder,
