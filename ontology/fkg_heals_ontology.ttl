@prefix fkg: <http://fkg.iitd.ac.in/ontology#> .
@prefix heals: <http://purl.org/heals/food/> .
@prefix heals-ing: <http://purl.org/heals/ingredient/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fkg:Carbohydrate a fkg:Nutrient ;
    rdfs:label "Carbohydrate" .

fkg:Energy a fkg:Nutrient ;
    rdfs:label "Energy" .

fkg:Fiber a fkg:Nutrient ;
    rdfs:label "Fiber" .

fkg:Haryana a fkg:Cuisine ;
    rdfs:label "Haryana" .

fkg:Jharkhand a fkg:Cuisine ;
    rdfs:label "Jharkhand" .

fkg:Lucknowi a fkg:Cuisine ;
    rdfs:label "Lucknowi" .

fkg:Malabar a fkg:Cuisine ;
    rdfs:label "Malabar" .

fkg:Nagaland a fkg:Cuisine ;
    rdfs:label "Nagaland" .

fkg:Oriya a fkg:Cuisine ;
    rdfs:label "Oriya" .

fkg:Protein a fkg:Nutrient ;
    rdfs:label "Protein" .

fkg:TotalFat a fkg:Nutrient ;
    rdfs:label "TotalFat" .

fkg:UttarPradesh a fkg:Cuisine ;
    rdfs:label "UttarPradesh" .

fkg:containsNutrient a owl:ObjectProperty ;
    rdfs:domain heals-ing:Ingredient ;
    rdfs:range fkg:Nutrient .

fkg:hasCuisine a owl:ObjectProperty ;
    rdfs:domain heals:Recipe ;
    rdfs:range fkg:Cuisine .

fkg:hasDietType a owl:ObjectProperty ;
    rdfs:domain heals:Recipe ;
    rdfs:range fkg:DietType .

fkg:hasIngredient a owl:ObjectProperty ;
    rdfs:domain heals:Recipe ;
    rdfs:range heals-ing:Ingredient .

fkg:hasNutrientQuantity a owl:DatatypeProperty ;
    rdfs:domain heals-ing:Ingredient ;
    rdfs:range xsd:float .

fkg:preparationTime a owl:DatatypeProperty ;
    rdfs:domain heals:Recipe ;
    rdfs:range xsd:integer .

