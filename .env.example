# Required for LLM-assisted recipe parsing
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Dataset selection and processing range
DATASET_NUMBER=1
START_INDEX=0
END_INDEX=10
INTERACTIVE_REVIEW=True
RATE_LIMIT_DELAY=2.1
BATCH_SIZE=10

# Optional paths; relative paths are resolved from this repository root
# OUTPUT_TTL=pipeline/output/food_kg.ttl
# STATE_DIR=pipeline/state
